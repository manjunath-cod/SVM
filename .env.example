# SVM ? Sangeeta Vrinda Madhyam Environment Configuration Template
# Copy this file to .env for local development

# ==========================================
# Firebase Web Configuration (Client-side)
# Required for Cloud Auth, Firestore & Storage
# Project: SVM1 (svm1-322e3)
# Get the Web API key from:
# Firebase Console > Project settings > General > Your apps (svm)
# IMPORTANT: The Firebase Web API key starts with "AIzaSy..."
# (Do NOT use Google AI Studio Gemini API key here - that causes auth/api-key-is-not-supported-by-this-api)
# ==========================================
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_WEB_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=svm1-322e3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=svm1-322e3
VITE_FIREBASE_STORAGE_BUCKET=svm1-322e3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=835790991293
VITE_FIREBASE_APP_ID=1:835790991293:web:2a2f06d5412c7be3216cd4

# ==========================================
# Google Gemini AI Integration (Server-side)
# Used for genuine creative submission rubric evaluations
# Get key from Google AI Studio: https://aistudio.google.com
# ==========================================
GEMINI_API_KEY=your-gemini-api-key

# Server Port (Defaults to 3000 if omitted)
PORT=3000
