# Google Gemini API Key for AI Talent Discovery & Showcase evaluation
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (used for standalone Node server, defaults to 5173 for Vite dev)
PORT=5173

# Optional Supabase Integration (if connecting to external Supabase project)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

